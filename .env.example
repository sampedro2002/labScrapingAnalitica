# Configuración de sesión con cookies para Instagram
# Copia este archivo como .env y coloca tus valores:
# Copy-Item .env.example .env

# Opción 1: Cookie individual sessionid (la más importante para autenticarte)
SESSIONID=tu_sessionid_aqui

# Variables complementarias opcionales
DS_USER_ID=tu_ds_user_id_aqui
CSRFTOKEN=tu_csrftoken_aqui

# Opción 2: O la cadena de cookies completa copiada del navegador
# INSTAGRAM_COOKIES="sessionid=...; ds_user_id=...; csrftoken=..."

# Clave de la API de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
# Modelo opcional (por defecto gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
